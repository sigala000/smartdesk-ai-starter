# Browser-safe Supabase configuration (required for Phase 2 authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration (not used by normal employee authentication)
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_RATE_LIMIT_SECRET=
# Set only when the deployment platform overwrites this header from a trusted proxy.
PUBLIC_CLIENT_IP_HEADER=
ATTACHMENT_ALLOW_UNSCANNED=false

# Server-only Meta WhatsApp Cloud API developer-test configuration
META_WHATSAPP_ENABLED=false
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_TEST_RECIPIENT=
META_WHATSAPP_REQUEST_TIMEOUT_MS=10000
META_WHATSAPP_MAX_WEBHOOK_BYTES=262144

# Server-only OpenAI configuration (optional until Phase 5)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REQUEST_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_MAX_TOOL_CALLS=4
OPENAI_HISTORY_MESSAGE_LIMIT=16
OPENAI_INPUT_CHARACTER_BUDGET=12000

# Canonical application URL (optional during local Phase 0 development)
APP_BASE_URL=
