{
  "name": "smartdesk-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:meta-test": "LOCAL_META_TEST=true node --env-file-if-exists=.env.local scripts/dev-local.mjs",
    "dev:whatsapp-proxy": "node scripts/whatsapp-webhook-proxy.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "vitest run tests/evaluations tests/unit/agent",
    "test:whatsapp": "vitest run tests/unit/meta tests/unit/services/whatsapp-channel-service.test.ts tests/unit/schemas/whatsapp-webhook.test.ts",
    "test:e2e": "playwright test",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "security:check": "npm run security:secrets && npm run security:dependencies",
    "build": "next build",
    "db:start": "supabase start",
    "db:start:ci": "supabase start --exclude realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level error",
    "db:test": "supabase test db && node scripts/test-reference-concurrency.mjs && node scripts/test-handoff-concurrency.mjs && node scripts/test-status-verification-concurrency.mjs && node scripts/test-employee-auth.mjs && node scripts/test-auth-routes.mjs && node scripts/test-request-routes.mjs && node scripts/test-public-conversation-routes.mjs && node scripts/test-attachment-routes.mjs && node scripts/test-request-status-routes.mjs",
    "db:types": "supabase gen types typescript --local --schema public | sed '${/^$/d;}' > lib/supabase/database.types.ts",
    "db:types:check": "npm run db:types && git diff --exit-code -- lib/supabase/database.types.ts",
    "db:seed:development": "node scripts/seed-development.mjs",
    "db:provision:demo-employee": "node scripts/provision-local-demo-employee.mjs",
    "db:seed:whatsapp:test": "node --env-file-if-exists=.env.local scripts/configure-whatsapp-test-account.mjs",
    "db:seed:whatsapp:local": "WHATSAPP_TARGET=local node --env-file-if-exists=.env.local scripts/configure-whatsapp-test-account.mjs",
    "attachments:cleanup": "node scripts/cleanup-abandoned-attachments.mjs",
    "db:verify": "npm run db:reset && npm run db:lint && npm run db:test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.10.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
